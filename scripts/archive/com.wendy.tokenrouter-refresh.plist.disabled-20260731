<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wendy.tokenrouter-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/wendy/tokenrouter/scripts/refresh.sh</string>
    </array>

    <!-- 每天凌晨 3:15 跑一次;机器睡眠时错过,唤醒后 launchd 补跑一次 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/wendy/tokenrouter/logs/refresh.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wendy/tokenrouter/logs/refresh.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/wendy/tokenrouter</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/wendy/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/wendy</string>
    </dict>

    <key>SessionCreate</key>
    <true/>
</dict>
</plist>
